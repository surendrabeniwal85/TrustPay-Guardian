# Auto detect text files and perform LF normalization on checkin
* text=auto

# Explicit text files
*.java text diff=java eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.properties text eol=lf

# Executable scripts
*.sh text eol=lf
*.ps1 text eol=crlf
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.mp4 binary
*.pdf binary
*.jar binary
