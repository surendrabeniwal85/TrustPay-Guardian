# ==============================================================================
# TrustPay Guardian — Local Environment Variables Example
# Copy this file to .env for local overrides (never commit .env)
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trustpay_guardian?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_local_mysql_password_here

# JWT Security Configuration (Minimum 256-bit / 32-character secret)
JWT_SECRET=TrustPayGuardianSecureJwtSecretKeyMustBeAtLeast32BytesLongForHS256Algorithm
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Client Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
