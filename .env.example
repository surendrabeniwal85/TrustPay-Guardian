# ==============================================================================
# TrustPay Guardian — Local Environment Variables Example
# Copy this file to .env for local overrides (never commit .env)
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Option A: Least Privilege Two-User Model)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trustpay_guardian?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Runtime Application Account (DML only: SELECT, INSERT, UPDATE, DELETE)
# Strictly NO DROP, CREATE, ALTER, INDEX, or REFERENCES permissions
SPRING_DATASOURCE_USERNAME=tpg_app
SPRING_DATASOURCE_PASSWORD=your_secure_tpg_app_password

# Flyway Schema Migration Account (DDL + DML)
# Used during startup and CI/CD pipelines to apply V1-V6 schema migrations
FLYWAY_USER=tpg_flyway
FLYWAY_PASSWORD=your_secure_tpg_flyway_password

# NOTE ON LOCAL DEVELOPMENT FALLBACK:
# In local development only, if you choose not to create two separate users,
# you may set both SPRING_DATASOURCE_USERNAME and FLYWAY_USER to 'root' (or a single admin user).
# However, the dual-user model must remain the default for staging and production.

# JWT Security Configuration (Minimum 256-bit / 32-character secret)
JWT_SECRET=TrustPayGuardianSecureJwtSecretKeyMustBeAtLeast32BytesLongForHS256Algorithm
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Client Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
